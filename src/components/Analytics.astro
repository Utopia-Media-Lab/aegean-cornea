---
// GA4 runs inside Google Tag Manager (GTM-NMGHQ2ZS), which loads only after "Allow analytics" and only on aegeancornea.com.
const gtmEnv = (import.meta.env.PUBLIC_GTM_ID ?? 'GTM-NMGHQ2ZS').trim().toUpperCase();
const gtmId = /^GTM-[A-Z0-9]+$/.test(gtmEnv) ? gtmEnv : '';
---

<div class="consent" id="consent" role="dialog" aria-labelledby="consent-title" aria-live="polite" hidden>
  <p id="consent-title"><strong>Analytics cookies.</strong> We use Google Analytics to understand how the site is used. Nothing is collected unless you allow it. <a href="/privacy">Privacy notice</a></p>
  <div class="consent-actions">
    <button type="button" data-consent="denied">Only necessary</button>
    <button type="button" data-consent="granted">Allow analytics</button>
  </div>
</div>

<style is:global>
  .consent{position:fixed;left:1rem;right:1rem;bottom:1rem;z-index:50;max-width:44rem;margin:0 auto;padding:1rem 1.25rem;display:flex;gap:1rem;align-items:center;justify-content:space-between;flex-wrap:wrap;background:#06183f;color:#fff;border:1px solid rgba(255,255,255,.24);font-size:.85rem;line-height:1.5}
  .consent[hidden]{display:none}
  .consent p{margin:0;flex:1 1 18rem}
  .consent a{color:inherit;text-underline-offset:.16em}
  .consent-actions{display:flex;gap:.6rem}
  .consent button,.consent-reset{font:inherit;cursor:pointer}
  .consent button{padding:.6rem 1rem;border:1px solid rgba(255,255,255,.76);background:transparent;color:#fff;font-weight:600}
  .consent button[data-consent="granted"]{background:#fff;color:#071f57}
  .consent button:focus-visible,.consent-reset:focus-visible{outline:3px solid #f1b52e;outline-offset:3px}
  .consent-reset{padding:0;border:0;background:none;color:inherit;text-transform:inherit;letter-spacing:inherit;text-decoration:underline;text-underline-offset:.16em}
</style>

<script is:inline define:vars={{ gtmId }}>
  // Consent Mode v2: everything is denied before any Google tag can load.
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500,
  });
  gtag('set', 'ads_data_redaction', true);

  var KEY = 'aegc-consent';
  var banner = document.getElementById('consent');
  // Only the public domain is measured: localhost and preview URLs never load a tag.
  var liveHost = /^(www\.)?aegeancornea\.com$/.test(window.location.hostname);
  var loaded = false;

  function read() {
    try { return localStorage.getItem(KEY); } catch (e) { return null; }
  }
  function write(value) {
    try { localStorage.setItem(KEY, value); } catch (e) {}
  }
  function load() {
    if (loaded || !liveHost || !gtmId) return;
    loaded = true;
    dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(gtmId);
    document.head.appendChild(s);
  }
  // Withdrawn or refused consent also removes the Google Analytics cookies this site can see.
  function clearAnalyticsCookies() {
    var host = window.location.hostname.replace(/^www\./, '');
    document.cookie.split(';').forEach(function (cookie) {
      var name = cookie.split('=')[0].trim();
      if (name !== '_ga' && name.indexOf('_ga_') !== 0) return;
      document.cookie = name + '=; Max-Age=0; path=/; SameSite=Lax';
      document.cookie = name + '=; Max-Age=0; path=/; domain=.' + host + '; SameSite=Lax';
    });
  }
  function apply(value) {
    if (value === 'granted') {
      gtag('consent', 'update', { analytics_storage: 'granted' });
      load();
    } else {
      gtag('consent', 'update', { analytics_storage: 'denied' });
      clearAnalyticsCookies();
    }
  }

  var saved = read();
  if (saved === 'granted' || saved === 'denied') apply(saved);
  else banner.hidden = false;

  banner.addEventListener('click', function (event) {
    var value = event.target && event.target.getAttribute && event.target.getAttribute('data-consent');
    if (!value) return;
    write(value);
    banner.hidden = true;
    apply(value);
  });

  document.addEventListener('click', function (event) {
    var target = event.target && event.target.closest ? event.target : null;
    if (!target) return;
    if (target.closest('[data-consent-reset]')) {
      banner.hidden = false;
      return;
    }
    // contact_click: only after consent, never with the address itself.
    var link = target.closest('a[href^="mailto:"], a[href^="tel:"]');
    if (!link || !loaded) return;
    dataLayer.push({
      event: 'contact_click',
      method: link.getAttribute('href').indexOf('tel:') === 0 ? 'phone' : 'email',
      location: link.closest('footer') ? 'footer' : link.closest('.contact-grid') ? 'contact' : 'page',
    });
  });
</script>
