{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aegean-cornea",
  "compatibility_date": "2026-11-18",
  // Static Astro site served by Workers Static Assets; no Worker script yet.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Branch builds run `wrangler preview` (Workers Previews), which needs this block.
  "previews": {}
}
